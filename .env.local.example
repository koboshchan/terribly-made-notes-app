# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# MongoDB Connection
MONGODB_URI=mongodb://mongo:27017/notesapp

# Server-only 32-byte base64 master wrapping key. Generate once, preserve securely.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_MASTER_KEY=
# Clerk user.deleted webhook signing secret
CLERK_WEBHOOK_SIGNING_SECRET=

# Data Directory (for file storage)
DATA_DIR=./data

# Next.js
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URL used for generating share links (set to your domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional comma-separated list of approved AI provider base URLs (defaults to OpenAI, Gemini, Groq, Anthropic)
# PROVIDER_BASE_URL_ALLOWLIST=https://api.openai.com/v1,https://generativelanguage.googleapis.com/v1beta/openai,https://api.groq.com/openai/v1

# Optional comma-separated list of additional authorized parties for Clerk tokens (e.g. native iOS app bundle IDs)
# CLERK_AUTHORIZED_PARTIES=com.kobosh.notes

